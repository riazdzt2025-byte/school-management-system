+{% extends 'students/base.html' %}
+
+{% block title %}SSC Registrations - Principal Kazi Faruky School And College{% endblock %}
+
+{% block content %}
+<div class="page-header">
+    <h1>SSC Registrations</h1>
+    <a class="btn btn-outline-navy" href="{% url 'import_ssc_registrations' %}">Import Excel</a>
+</div>
+
+<form method="get" class="mb-3">
+    <select name="session" class="form-select" style="max-width:240px" onchange="this.form.submit()">
+        <option value="">All Sessions</option>
+        {% for item in sessions %}
+            <option value="{{ item }}" {% if item == selected_session %}selected{% endif %}>{{ item }}</option>
+        {% endfor %}
+    </select>
+</form>
+
+<div class="table-card">
+    <div class="table-responsive">
+        <table class="table table-striped mb-0">
+            <thead>
+                <tr>
+                    <th>Registration</th>
+                    <th>Student</th>
+                    <th>Roll</th>
+                    <th>Session</th>
+                    <th>Group</th>
+                    <th>Board</th>
+                    <th>Result</th>
+                    <th>Actions</th>
+                </tr>
+            </thead>
+            <tbody>
+                {% for reg in registrations %}
+                <tr>
+                    <td>{{ reg.registration_number }}</td>
+                    <td>{{ reg.student.name }}</td>
+                    <td>{{ reg.roll_number }}</td>
+                    <td>{{ reg.session }}</td>
+                    <td>{{ reg.get_group_display }}</td>
+                    <td>{{ reg.get_board_display }}</td>
+                    <td>
+                        {% if reg.board_result %}
+                            {{ reg.board_result.get_result_status_display }} ({{ reg.board_result.gpa }})
+                        {% else %}
+                            <span class="badge bg-secondary">Pending</span>
+                        {% endif %}
+                    </td>
+                    <td>
+                        <a href="{% url 'edit_ssc_registration' reg.pk %}" class="btn btn-sm btn-outline-warning">Edit</a>
+                        {% if reg.board_result %}
+                            <a href="{% url 'edit_board_result' reg.board_result.pk %}" class="btn btn-sm btn-outline-info">Result</a>
+                        {% else %}
+                            <a href="{% url 'add_board_result' reg.pk %}" class="btn btn-sm btn-outline-success">Add Result</a>
+                        {% endif %}
+                    </td>
+                </tr>
+                {% empty %}
+                <tr><td colspan="8" class="text-center py-4">No SSC registrations yet.</td></tr>
+                {% endfor %}
+            </tbody>
+        </table>
+    </div>
+</div>
+{% endblock %}
