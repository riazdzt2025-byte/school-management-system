+{% extends 'students/base.html' %}
+
+{% block title %}Accounts Admission Queue - Principal Kazi Faruky School And College{% endblock %}
+
+{% block content %}
+<div class="page-header">
+    <div>
+        <h1>Accounts Admission Queue</h1>
+        <div class="subtitle">Admission applications pending payment approval</div>
+    </div>
+</div>
+
+<form method="get" class="d-flex gap-2 mb-3">
+    <input type="text" name="admission_class" value="{{ admission_class }}" class="form-control" style="max-width:220px" placeholder="Class">
+    <button type="submit" class="btn btn-outline-navy">Filter</button>
+</form>
+
+<div class="table-card">
+    <table class="table table-striped mb-0">
+        <thead>
+            <tr>
+                <th>Application</th>
+                <th>Applicant</th>
+                <th>Institution</th>
+                <th>Class</th>
+                <th></th>
+            </tr>
+        </thead>
+        <tbody>
+            {% for application in applications %}
+            <tr>
+                <td>{{ application.application_number }}</td>
+                <td>{{ application.applicant_name }}</td>
+                <td>{{ application.institution }}</td>
+                <td>{{ application.requested_class }}</td>
+                <td><a href="{% url 'admission_application_detail' application.pk %}">Open</a></td>
+            </tr>
+            {% empty %}
+            <tr><td colspan="5" class="text-center py-4">No pending payments.</td></tr>
+            {% endfor %}
+        </tbody>
+    </table>
+</div>
+{% endblock %}
