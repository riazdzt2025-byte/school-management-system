From 4dfb02a8acef044c93eb9dfe3d3bb3585cdc31f0 Mon Sep 17 00:00:00 2001
From: Habib <habib@example.com>
Date: Mon, 31 Aug 2026 09:48:31 +0000
Subject: [PATCH] Track and display each student's Last Registration
 (Year/Class/Section/Roll)

- StudentPromotionHistory gains source_roll_no, captured at promotion time
- Student.last_registration() returns the most recent non-rolled-back
  promotion's year (batch.session), class, section, and roll
- student_detail view/template show a 'Last Registration' card when
  history exists, matching the Quick Admission reference form's
  Last Reg. Year/Class/Section/Roll display
- Migration 0021_studentpromotionhistory_source_roll_no
---
 .../templates/students/student_detail.html    | 12 +++++++++++
 ..._studentpromotionhistory_source_roll_no.py | 18 ++++++++++++++++
 students/models.py                            | 21 +++++++++++++++++++
 students/views.py                             |  5 +++--
 4 files changed, 54 insertions(+), 2 deletions(-)
 create mode 100644 students/migrations/0021_studentpromotionhistory_source_roll_no.py

diff --git a/school_system/templates/students/student_detail.html b/school_system/templates/students/student_detail.html
index e029835..1858342 100644
--- a/school_system/templates/students/student_detail.html
+++ b/school_system/templates/students/student_detail.html
@@ -29,6 +29,18 @@
     </table>
 </div>
 
+{% if last_registration %}
+<div class="table-card mb-4" style="max-width: 640px;">
+    <table class="table table-bordered mb-0">
+        <tr><th colspan="2">Last Registration</th></tr>
+        <tr><th>Year</th><td>{{ last_registration.year }}</td></tr>
+        <tr><th>Class</th><td>{{ last_registration.admission_class }}</td></tr>
+        <tr><th>Section</th><td>{{ last_registration.section|default:"—" }}</td></tr>
+        <tr><th>Roll</th><td>{{ last_registration.roll_no|default:"—" }}</td></tr>
+    </table>
+</div>
+{% endif %}
+
 {% if transfer_certificate %}
 <div class="alert alert-warning" style="max-width: 640px;">
     <h4>Transfer Certificate Issued</h4>
diff --git a/students/migrations/0021_studentpromotionhistory_source_roll_no.py b/students/migrations/0021_studentpromotionhistory_source_roll_no.py
new file mode 100644
index 0000000..c563e45
--- /dev/null
+++ b/students/migrations/0021_studentpromotionhistory_source_roll_no.py
@@ -0,0 +1,18 @@
+# Generated by Django 6.1 on 2026-08-31 09:48
+
+from django.db import migrations, models
+
+
+class Migration(migrations.Migration):
+
+    dependencies = [
+        ('students', '0020_sectioncapacity'),
+    ]
+
+    operations = [
+        migrations.AddField(
+            model_name='studentpromotionhistory',
+            name='source_roll_no',
+            field=models.IntegerField(blank=True, null=True),
+        ),
+    ]
diff --git a/students/models.py b/students/models.py
index ba68405..a61fe50 100644
--- a/students/models.py
+++ b/students/models.py
@@ -120,6 +120,26 @@ class Student(models.Model):
     def __str__(self):
         return f"{self.name} ({self.student_id})"
 
+    def last_registration(self):
+        """সবচেয়ে সাম্প্রতিক (রোলব্যাক হয়নি এমন) প্রমোশন থেকে এই ছাত্রের
+        আগের রেজিস্ট্রেশন তথ্য — Year (batch.session), Class, Section, Roll।
+        কোনো প্রমোশন হিস্ট্রি না থাকলে None।"""
+        history = (
+            self.promotion_history
+            .filter(rolled_back_at__isnull=True)
+            .select_related('batch')
+            .order_by('-promoted_at')
+            .first()
+        )
+        if not history:
+            return None
+        return {
+            'year': history.batch.session,
+            'admission_class': history.source_class,
+            'section': history.source_section,
+            'roll_no': history.source_roll_no,
+        }
+
 
 class SectionCapacity(models.Model):
     """সিট লিমিট: একটা Institution + Class + Section-এ সর্বোচ্চ কতজন
@@ -206,6 +226,7 @@ class StudentPromotionHistory(models.Model):
     student = models.ForeignKey(Student, on_delete=models.CASCADE, related_name='promotion_history')
     source_class = models.CharField(max_length=10)
     source_section = models.CharField(max_length=5, blank=True)
+    source_roll_no = models.IntegerField(null=True, blank=True)
     target_class = models.CharField(max_length=10)
     target_section = models.CharField(max_length=5, blank=True)
     promoted_at = models.DateTimeField(auto_now_add=True)
diff --git a/students/views.py b/students/views.py
index 15d3823..02c67dc 100644
--- a/students/views.py
+++ b/students/views.py
@@ -819,6 +819,7 @@ def student_detail(request, pk):
         'student': student,
         'subjects': student.subjects.select_related('subject'),
         'transfer_certificate': getattr(student, 'transfer_certificate', None),
+        'last_registration': student.last_registration(),
     })
 
 
@@ -2269,8 +2270,8 @@ def student_promotion(request):
                     target_section = data['to_section'] or student.section
                     histories.append(StudentPromotionHistory(
                         batch=batch, student=student, source_class=student.admission_class,
-                        source_section=student.section, target_class=data['to_class'],
-                        target_section=target_section,
+                        source_section=student.section, source_roll_no=student.roll_no,
+                        target_class=data['to_class'], target_section=target_section,
                     ))
                     student.admission_class = data['to_class']
                     student.section = target_section
