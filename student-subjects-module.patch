+{% extends 'students/base.html' %}
+
+{% block title %}Tests & Marksheets - {{ block.super }}{% endblock %}
+
+{% block content %}
+<div class="page-header d-print-none">
+    <div>
+        <h1>{{ student.name }}</h1>
+        <div class="subtitle">Tests & Marksheets — {{ student.student_id }}, Class {{ student.admission_class }}{% if student.section %} ({{ student.section }}){% endif %}</div>
+    </div>
+    <a href="{% url 'student_detail' student.pk %}" class="btn btn-outline-navy">Back to Student</a>
+</div>
+
+<div class="table-card">
+    <div class="table-responsive">
+        <table class="table table-striped mb-0">
+            <thead>
+                <tr>
+                    <th>Exam</th>
+                    <th>Type</th>
+                    <th>Session</th>
+                    <th>Status</th>
+                    <th>Action</th>
+                </tr>
+            </thead>
+            <tbody>
+                {% for exam in exams %}
+                <tr>
+                    <td>{{ exam.name }}</td>
+                    <td>{{ exam.get_exam_type_display }}</td>
+                    <td>{{ exam.session }}</td>
+                    <td>
+                        {% if exam.is_published %}
+                        <span class="badge bg-success">Published</span>
+                        {% else %}
+                        <span class="badge bg-secondary">Not Published</span>
+                        {% endif %}
+                    </td>
+                    <td>
+                        <a href="{% url 'student_result_detail' exam.pk student.pk %}" class="btn btn-sm btn-outline-info">Test Result</a>
+                        {% if exam.is_published %}
+                        <a href="{% url 'result_card' exam.pk student.pk %}" class="btn btn-sm btn-outline-dark">Marksheet</a>
+                        {% else %}
+                        <button class="btn btn-sm btn-outline-secondary" disabled title="Marksheet available after result is published">Marksheet</button>
+                        {% endif %}
+                    </td>
+                </tr>
+                {% empty %}
+                <tr><td colspan="5" class="text-center text-muted py-4">No exams found for this student yet.</td></tr>
+                {% endfor %}
+            </tbody>
+        </table>
+    </div>
+</div>
+{% endblock %}
