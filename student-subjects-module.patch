+{% extends 'students/base.html' %}
+
+{% block title %}Remove Subject Assignment - {{ block.super }}{% endblock %}
+
+{% block content %}
+<div class="page-header">
+    <div>
+        <h1>Remove Subject Assignment</h1>
+        <div class="subtitle">{{ requirement.subject.name }} — {{ requirement.institution.name }} / Class {{ requirement.admission_class }}</div>
+    </div>
+</div>
+
+<div class="table-card p-4" style="max-width: 560px;">
+    <p>Are you sure you want to remove this subject assignment? Students who already chose this
+       subject will keep their historical marks, but it will no longer be offered going forward.</p>
+    <form method="POST">
+        {% csrf_token %}
+        <div class="d-flex gap-2">
+            <button type="submit" class="btn btn-danger">Confirm Remove</button>
+            <a href="{% url 'subject_requirement_list' %}" class="btn btn-outline-secondary">Cancel</a>
+        </div>
+    </form>
+</div>
+{% endblock %}
diff --git a/students/templates/students/discontinue_student.html b/students/templates/students/discontinue_student.html
