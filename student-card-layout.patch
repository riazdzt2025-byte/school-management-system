+    .student-card-actions .btn { flex: 0 0 auto; }
+    .student-card-empty {
+        grid-column: 1 / -1; text-align: center; color: #6c757d; padding: 48px 16px;
+    }
+    .print-table-wrapper { display: none; }
+    @media print {
+        .student-grid { display: none !important; }
+        .print-table-wrapper { display: block !important; }
+    }
+{% endblock %}
