+    """Institution ID -> list of that Institution's classes, as a JSON
+    string ready to embed in a template <script> tag. Used by add_exam.html
+    to repopulate the Class dropdown when the Institution is changed."""
+    return json.dumps({
+        str(inst.id): [c.strip() for c in inst.classes.split(',') if c.strip()]
+        for inst in Institution.objects.all()
+    })
