-<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Accounts</title><link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet"><style>body{background:#f6f7fa;padding:32px 40px}h1{color:#0f2d52}.stat{background:#fff;padding:20px;border-radius:12px;box-shadow:0 4px 14px #0f2d5215}.value{font-size:1.5rem;font-weight:bold;color:#0f2d52}.card{border:0;box-shadow:0 4px 14px #0f2d5215}</style></head><body><div class="d-flex justify-content-between align-items-center"><h1>Accounts</h1><a href="{% url 'dashboard' %}" class="btn btn-outline-secondary">Dashboard</a></div><div class="row g-3 mt-2">{% for label,value in finance_cards %}<div class="col-md-3"><div class="stat"><small>{{ label }}</small><div class="value">৳ {{ value }}</div></div></div>{% endfor %}<div class="col-md-3"><div class="stat"><small>Net Balance</small><div class="value">৳ {{ net_balance }}</div></div></div></div><div class="my-4"><a href="{% url 'money_receipt_list' %}" class="btn btn-outline-primary">Money Receipts</a> <a href="{% url 'voucher_list' %}" class="btn btn-outline-primary">Vouchers</a> <a href="{% url 'salary_sheet_list' %}" class="btn btn-outline-primary">Salary Sheets</a> <a href="{% url 'accounts_admission_queue' %}" class="btn btn-outline-primary">Admission Payments</a> <a href="{% url 'student_promotion' %}" class="btn btn-outline-dark">Student Promotion</a></div><div class="row"><div class="col-md-6"><div class="card p-3"><h5>Recent Receipts</h5>{% for r in recent_receipts %}<p>{{ r.receipt_no }} - {{ r.student.name }} - ৳{{ r.amount }}</p>{% empty %}<p>No receipts yet.</p>{% endfor %}</div></div><div class="col-md-6"><div class="card p-3"><h5>Recent Vouchers</h5>{% for v in recent_vouchers %}<p>{{ v.purpose }} - ৳{{ v.amount }} ({{ v.get_status_display }})</p>{% empty %}<p>No vouchers yet.</p>{% endfor %}</div></div></div></body></html>
+{% extends 'students/base.html' %}
+
+{% block title %}Accounts - Principal Kazi Faruky School And College{% endblock %}
+
+{% block extra_style %}
+    .stat { background: #fff; padding: 20px; border-radius: 12px; box-shadow: 0 4px 14px rgba(15,45,82,0.08); }
+    .stat .value { font-size: 1.5rem; font-weight: bold; color: var(--navy); }
+{% endblock %}
+
+{% block content %}
+<div class="page-header">
+    <div>
+        <h1>Accounts</h1>
+        <div class="subtitle">Finance overview and collections</div>
+    </div>
+</div>
+
+<div class="row g-3">
+    {% for label, value in finance_cards %}
+    <div class="col-md-3">
+        <div class="stat">
+            <small>{{ label }}</small>
+            <div class="value">৳ {{ value }}</div>
+        </div>
+    </div>
+    {% endfor %}
+    <div class="col-md-3">
+        <div class="stat">
+            <small>Net Balance</small>
+            <div class="value">৳ {{ net_balance }}</div>
+        </div>
+    </div>
+</div>
+
+<div class="my-4">
+    <a href="{% url 'money_receipt_list' %}" class="btn btn-outline-navy">Money Receipts</a>
+    <a href="{% url 'voucher_list' %}" class="btn btn-outline-navy">Vouchers</a>
+    <a href="{% url 'salary_sheet_list' %}" class="btn btn-outline-navy">Salary Sheets</a>
+    <a href="{% url 'accounts_admission_queue' %}" class="btn btn-outline-navy">Admission Payments</a>
+    <a href="{% url 'student_promotion' %}" class="btn btn-outline-navy">Student Promotion</a>
+</div>
+
+<div class="row">
+    <div class="col-md-6">
+        <div class="table-card p-3">
+            <h5>Recent Receipts</h5>
+            {% for r in recent_receipts %}
+                <p>{{ r.receipt_no }} - {{ r.student.name }} - ৳{{ r.amount }}</p>
+            {% empty %}
+                <p>No receipts yet.</p>
+            {% endfor %}
+        </div>
+    </div>
+    <div class="col-md-6">
+        <div class="table-card p-3">
+            <h5>Recent Vouchers</h5>
+            {% for v in recent_vouchers %}
+                <p>{{ v.purpose }} - ৳{{ v.amount }} ({{ v.get_status_display }})</p>
+            {% empty %}
+                <p>No vouchers yet.</p>
+            {% endfor %}
+        </div>
+    </div>
+</div>
+{% endblock %}
