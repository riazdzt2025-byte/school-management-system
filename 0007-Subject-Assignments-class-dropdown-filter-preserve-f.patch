+
+{% block extra_script %}
+<script>
+    (function () {
+        const dataEl = document.getElementById('sr-institutions-data');
+        if (!dataEl) return;
+        const institutionsData = JSON.parse(dataEl.textContent);
+        const institutionSelect = document.getElementById('sr-institution');
+        const classSelect = document.getElementById('sr-class');
+        const currentClassValue = "{{ selected_class|default:'' }}";
+
+        function populateClasses(selectedInstitutionId, preSelectValue) {
+            classSelect.innerHTML = '<option value="">-- All Classes --</option>';
+            const classes = institutionsData[selectedInstitutionId] || [];
+            classes.forEach(function (cls) {
+                const opt = document.createElement('option');
+                opt.value = cls;
+                opt.textContent = cls;
+                if (cls === preSelectValue) {
+                    opt.selected = true;
+                }
+                classSelect.appendChild(opt);
+            });
+        }
+
+        institutionSelect.addEventListener('change', function () {
+            populateClasses(this.value, '');
+        });
+
+        if (institutionSelect.value) {
+            populateClasses(institutionSelect.value, currentClassValue);
+        }
+    })();
+</script>
+{% endblock %}
