# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# DATABASE_URL=postgres://user:password@host:port/dbname
# HTTPS behind a reverse proxy (Render/Nginx). Set True in production when the
# proxy forwards X-Forwarded-Proto, otherwise login POSTs fail with CSRF 403.
TRUST_FORWARDED_PROTO=False
USE_X_FORWARDED_HOST=False
# Comma separated, scheme included, e.g. https://myapp.onrender.com
CSRF_TRUSTED_ORIGINS=
# Mail backend for the default mailer (Django 6.0+ MAILERS setting). Nothing in
# the app sends email today, so the console backend is the default everywhere.
# Django 6+ has an Error-level deploy check (mail.E001): check --deploy FAILS
# while MAILERS_BACKEND is a development-only backend (console/filebased/
# locmem/dummy), so production must set a real one, e.g.:
# MAILERS_BACKEND=django.core.mail.backends.smtp.EmailBackend
# A subject with no mark entered counts as a failed (F) subject, per the SSC
# rule. Set False to leave un-entered subjects out of the result entirely.
EXAM_ABSENT_SUBJECT_FAILS=True
# A published exam's marks are the record its printed sheets were built from, so
# they are locked after publishing until explicitly unlocked (audited). Set
# False to allow marks edits on a published exam without unlocking.
EXAM_LOCK_PUBLISHED=True

# Upload / media security
# Student photos (ImageField) are validated server-side (max 2MB, image types only).
# Excel imports (FileField) validated server-side (max 10MB, .xlsx only).
# In production, MEDIA_URL should be served by nginx / CDN, not Django.
# Add media/ to .gitignore to prevent committing photos / uploads (PII).
# MEDIA_ROOT: point this at a persistent disk / object-storage mount in
# production so uploaded photos survive redeploys (D-7). Defaults to BASE_DIR/media.
# MEDIA_ROOT=/data/media
#
# --- Object storage for media (D-7, the free-tier fix) -----------------------
# Render's free tier wipes the container disk on every deploy, so /data/media
# is not an option there. Put uploads in an S3-compatible bucket instead
# (Cloudflare R2, Backblaze B2, AWS S3, MinIO). Off by default: unset USE_S3
# and behaviour is exactly the filesystem storage above.
# See docs/FREE_TIER_MEDIA_STORAGE.md for the copy-paste setup.
# USE_S3=True
# AWS_STORAGE_BUCKET_NAME=school-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# R2/B2/MinIO: the S3 endpoint + its region ('auto' for R2). Leave both unset
# for real AWS S3.
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# Key prefix inside the bucket (default: media)
# AWS_LOCATION=media
# Public read access: set to your public bucket / CDN origin to serve files
# directly. Leave EMPTY to keep the bucket private and serve signed URLs —
# the safer default, since these are photos of students.
# AWS_S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# Signed-URL lifetime in seconds when the bucket is private (default 86400)
# AWS_S3_QUERYSTRING_EXPIRE=86400
# Override the generated media URL prefix entirely (wins over the above)
# MEDIA_URL=

# Backup ops (see docs/BACKUP_RESTORE_GUIDE.md and docs/BACKUP_AND_RESTORE.md) —
# used by manage.py backup_data / check_backups and scripts/backup_cron.sh.
# Never commit real values.
# P0B_BACKUP_ROOT: where backup folders live; MUST be a persistent location in
# production (a cron job's filesystem is ephemeral). Defaults to ./backups.
# P0B_BACKUP_ROOT=/data/backups
# HEALTHCHECK_PING_URL: external health check pinged on success/failure
# (e.g. https://hc-ping.com/<uuid>) — opens the alert for backup failures.
# HEALTHCHECK_PING_URL=
# BACKUP_MAX_AGE_HOURS=48   # newest backup this fresh or it's considered stale
# KEEP_BACKUPS=7            # number of newest backup folders to keep
#
# --- Encryption at rest (optional but recommended) --------------------------
# Backups are a full copy of the school's PII. Artifacts are always written 0600
# inside a 0700 folder; this adds real encryption on top.
# BACKUP_ENCRYPTION=openssl        # off (default) | openssl (AES-256-CBC+PBKDF2) | age
# Preferred: a 0600 file with the passphrase (does not appear in the scheduler's
# environment). BACKUP_PASSPHRASE works too but is more exposed.
# BACKUP_PASSPHRASE_FILE=/etc/sms/backup.key
# BACKUP_PASSPHRASE=
# For BACKUP_ENCRYPTION=age instead: the public key to encrypt with, and the
# identity file (private key) needed to decrypt.
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_AGE_IDENTITY_FILE=/etc/sms/backup.age
# Losing the passphrase means losing the backup — keep it in a password manager.
#
# --- Independent off-box copy (optional; needs a bucket) --------------------
# A backup on the same disk as the database does not survive losing that disk.
# Set all three required variables to push one packed, server-side-encrypted
# bundle per backup. Use a key scoped to THIS bucket, not the media key.
# BACKUP_OBJECT_STORAGE_BUCKET=sms-backups
# BACKUP_OBJECT_STORAGE_ACCESS_KEY=
# BACKUP_OBJECT_STORAGE_SECRET_KEY=
# R2/B2/MinIO endpoint + region ('auto' for R2); leave both unset for real AWS S3.
# BACKUP_OBJECT_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_OBJECT_STORAGE_REGION=auto
# BACKUP_OBJECT_STORAGE_PREFIX=backups   # key prefix inside the bucket
# BACKUP_OBJECT_STORAGE_KEEP=30          # remote bundles to retain
#
# --- Reading the off-box copy back (recovery from a lost host) --------------
# `manage.py fetch_backup --list` shows what the bucket holds;
# `manage.py fetch_backup --latest` downloads the newest bundle, verifies it
# against its own manifest and unpacks it into the local backup root, ready for
# `manage.py restore_backup --backup backup-<stamp>` (drill it into a disposable
# target first). Nothing here writes to the database.
#
# scripts/backup_cron.sh runs `check_backups --check-remote` automatically as
# soon as BACKUP_OBJECT_STORAGE_BUCKET is set, so an upload that quietly stopped
# (rotated key, renamed bucket, expired credential) fails the health check
# instead of reporting a healthy local-only backup. Set this to 1 to skip that
# gate for a run:
# BACKUP_SKIP_REMOTE_CHECK=0
