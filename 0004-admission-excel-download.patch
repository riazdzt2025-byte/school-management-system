+{% block extra_script %}
+<script>
+    // "Share Application Link" — prompts for a WhatsApp number and opens
+    // WhatsApp (web or app) with the public Admission Application form
+    // link pre-filled as a message, ready to send.
+    document.getElementById('share-application-link-btn').addEventListener('click', function() {
+        const rawNumber = prompt('WhatsApp নাম্বার লিখুন (যেমন: 01xxxxxxxxx বা +8801xxxxxxxxx):');
+        if (!rawNumber) { return; }
+
+        // Normalize to WhatsApp's required international format (digits only,
+        // no leading + or 0). Accepts local (01...), +880..., 880..., or 0088...
+        let digits = rawNumber.replace(/[^0-9]/g, '');
+        if (digits.startsWith('00')) {
+            digits = digits.slice(2);
+        }
+        if (digits.startsWith('0')) {
+            digits = '880' + digits.slice(1);
+        } else if (!digits.startsWith('880')) {
+            digits = '880' + digits;
+        }
+
+        if (digits.length < 12 || digits.length > 13) {
+            alert('নাম্বারটা সঠিক মনে হচ্ছে না। আবার চেষ্টা করুন (যেমন: 01712345678)।');
+            return;
+        }
+
+        const formLink = window.location.origin + "{% url 'public_admission_apply' %}";
+        const message = 'Admission Application form: ' + formLink;
+        const waUrl = 'https://wa.me/' + digits + '?text=' + encodeURIComponent(message);
+        window.open(waUrl, '_blank');
+    });
+</script>
 {% endblock %}
