+    // ---- Inline filter bar: cascading class dropdown + group visibility ----
+    (function () {
+        const dataEl = document.getElementById('ilf-institutions-data');
+        if (!dataEl) return;
+        const institutionsData = JSON.parse(dataEl.textContent);
+        const institutionSelect = document.getElementById('ilf-institution');
+        const classSelect = document.getElementById('ilf-class');
+        const groupSelect = document.getElementById('ilf-group');
+        const groupContainer = document.getElementById('ilf-group-container');
+        const currentClassValue = "{{ selected_class|default:'' }}";
+
+        function updateGroupVisibility() {
+            const cls = classSelect.value;
+            if (cls && ['9', '10', '11', '12'].includes(cls)) {
+                groupContainer.style.display = 'flex';
+            } else {
+                groupContainer.style.display = 'none';
+                groupSelect.value = '';
+            }
+        }
+
+        function populateClasses(selectedInstitutionId, preSelectValue) {
+            classSelect.innerHTML = '<option value="">-- All --</option>';
+            const classes = institutionsData[selectedInstitutionId] || [];
+            classes.forEach(function (cls) {
+                const opt = document.createElement('option');
+                opt.value = cls;
+                opt.textContent = cls;
+                if (cls === preSelectValue) {
+                    opt.selected = true;
+                }
+                classSelect.appendChild(opt);
+            });
+            updateGroupVisibility();
+        }
+
+        institutionSelect.addEventListener('change', function () {
+            populateClasses(this.value, '');
+        });
+        classSelect.addEventListener('change', updateGroupVisibility);
+
+        if (institutionSelect.value) {
+            populateClasses(institutionSelect.value, currentClassValue);
+        }
+    })();
 </script>
